# API Configuration
API_TITLE=Zweitstimme Polling API
API_VERSION=1.0.0
API_DESCRIPTION=German election polling data API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Security
API_SECRET=your-secret-key-change-in-production

# Database (SQLite)
DATABASE_URL=sqlite:///data/polling.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///data/polling.db

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_REPO=zweitstimme/data

# Scraper settings
SCRAPER_DELAY=1.0
SCRAPER_TIMEOUT=30
